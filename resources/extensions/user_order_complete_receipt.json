{
    "target_layout": "shop/order_complete",
    "injections": [
        {
            "target_id": "order_complete_payment_summary",
            "position": "append_child",
            "components": [
                {
                    "type": "basic",
                    "name": "Div",
                    "if": "{{orderData?.data?.payment?.pg_provider === 'nhnkcp' && orderData?.data?.payment?.transaction_id}}",
                    "props": { "className": "pt-4 mt-2 border-t border-gray-200 dark:border-gray-700" },
                    "children": [
                        {
                            "type": "basic",
                            "name": "Div",
                            "props": { "className": "flex items-center justify-between" },
                            "children": [
                                {
                                    "type": "basic",
                                    "name": "Span",
                                    "props": { "className": "text-gray-600 dark:text-gray-400 text-sm" },
                                    "text": "$t:sirsoft-pay-nhnkcp.user.receipt_label"
                                },
                                {
                                    "type": "basic",
                                    "name": "Div",
                                    "props": { "className": "flex items-center gap-3" },
                                    "children": [
                                        {
                                            "type": "basic",
                                            "name": "Button",
                                            "if": "{{!_local._kcpOcReceiptLoaded}}",
                                            "props": {
                                                "type": "button",
                                                "className": "inline-flex items-center gap-1 text-sm text-blue-600 dark:text-blue-400 hover:underline disabled:opacity-50",
                                                "disabled": "{{_local._kcpOcReceiptLoading === true}}"
                                            },
                                            "actions": [
                                                {
                                                    "type": "click",
                                                    "handler": "sequence",
                                                    "actions": [
                                                        {
                                                            "handler": "setState",
                                                            "params": { "target": "local", "_kcpOcReceiptLoading": true }
                                                        },
                                                        {
                                                            "handler": "apiCall",
                                                            "auth_required": true,
                                                            "target": "/api/plugins/sirsoft-pay-nhnkcp/user/orders/{{route.id}}/receipt",
                                                            "params": { "method": "GET" },
                                                            "onSuccess": [
                                                                {
                                                                    "handler": "setState",
                                                                    "params": {
                                                                        "target": "local",
                                                                        "_kcpOcReceiptLoading": false,
                                                                        "_kcpOcReceiptLoaded": true,
                                                                        "_kcpOcReceiptUrl": "{{$response.receipt_url}}",
                                                                        "_kcpOcCashReceiptUrl": "{{$response.cash_receipt_url}}"
                                                                    }
                                                                }
                                                            ],
                                                            "onError": [
                                                                {
                                                                    "handler": "setState",
                                                                    "params": { "target": "local", "_kcpOcReceiptLoading": false }
                                                                }
                                                            ]
                                                        }
                                                    ]
                                                }
                                            ],
                                            "children": [
                                                {
                                                    "type": "basic",
                                                    "name": "Icon",
                                                    "if": "{{_local._kcpOcReceiptLoading === true}}",
                                                    "props": { "name": "spinner", "className": "w-3.5 h-3.5 animate-spin" }
                                                },
                                                {
                                                    "type": "basic",
                                                    "name": "Icon",
                                                    "if": "{{!_local._kcpOcReceiptLoading}}",
                                                    "props": { "name": "file-text", "className": "w-3.5 h-3.5" }
                                                },
                                                {
                                                    "type": "basic",
                                                    "name": "Span",
                                                    "text": "$t:sirsoft-pay-nhnkcp.user.receipt_view"
                                                }
                                            ]
                                        },
                                        {
                                            "type": "basic",
                                            "name": "A",
                                            "if": "{{_local._kcpOcReceiptLoaded && _local._kcpOcReceiptUrl}}",
                                            "props": {
                                                "href": "{{_local._kcpOcReceiptUrl}}",
                                                "target": "_blank",
                                                "rel": "noopener noreferrer",
                                                "className": "inline-flex items-center gap-1 text-sm text-blue-600 dark:text-blue-400 hover:underline"
                                            },
                                            "children": [
                                                {
                                                    "type": "basic",
                                                    "name": "Icon",
                                                    "props": { "name": "file-text", "className": "w-3.5 h-3.5" }
                                                },
                                                {
                                                    "type": "basic",
                                                    "name": "Span",
                                                    "text": "$t:sirsoft-pay-nhnkcp.user.receipt_view"
                                                }
                                            ]
                                        },
                                        {
                                            "type": "basic",
                                            "name": "A",
                                            "if": "{{_local._kcpOcReceiptLoaded && _local._kcpOcCashReceiptUrl}}",
                                            "props": {
                                                "href": "{{_local._kcpOcCashReceiptUrl}}",
                                                "target": "_blank",
                                                "rel": "noopener noreferrer",
                                                "className": "inline-flex items-center gap-1 text-sm text-green-600 dark:text-green-400 hover:underline"
                                            },
                                            "children": [
                                                {
                                                    "type": "basic",
                                                    "name": "Icon",
                                                    "props": { "name": "receipt", "className": "w-3.5 h-3.5" }
                                                },
                                                {
                                                    "type": "basic",
                                                    "name": "Span",
                                                    "text": "$t:sirsoft-pay-nhnkcp.user.cash_receipt_view"
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    ]
}
